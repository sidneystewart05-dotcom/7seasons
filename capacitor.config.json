{
  "appId": "com.sidneystewart.sevenseasons",
  "appName": "7 Seasons",
  "webDir": "public",
  "server": {
    "url": "https://7seasons-production-fd66.up.railway.app"
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "SevenSeasons"
  },
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "style": "default",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1500,
      "backgroundColor": "#2D3F50",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "overlaysWebView": true
    }
  }
}
